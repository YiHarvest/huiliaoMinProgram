<view class="page-container">
  <view class="tabs-container">
    <view 
      wx:for="{{tabs}}" 
      wx:key="key"
      class="tab-item {{activeTab === item.key ? 'active' : ''}}"
      bindtap="switchTab"
      data-tab="{{item.key}}"
    >
      <text class="tab-text">{{item.label}}</text>
      <view class="tab-indicator" wx:if="{{activeTab === item.key}}"></view>
    </view>
  </view>

  <scroll-view class="content-scroll" scroll-y>
    <view wx:if="{{loading}}" class="loading-container">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>

    <view wx:elif="{{error}}" class="error-container">
      <text class="error-text">加载失败，请稍后重试</text>
      <button class="retry-btn" bindtap="retryLoad">重新加载</button>
    </view>

    <view wx:elif="{{currentList.length === 0}}" class="empty-container">
      <view class="empty-icon">
        <text class="empty-icon-text">📊</text>
      </view>
      <text class="empty-text">{{emptyText}}</text>
    </view>

    <view wx:else class="list-container">
      <view 
        wx:for="{{currentList}}" 
        wx:key="id"
        class="list-card scale-card {{activeTab === 'report' && item.uiState === 'deleting' ? 'list-card--deleting' : ''}}"
        bindtap="handleView"
        bindlongpress="handleCardLongPress"
        data-item="{{item}}"
      >
        <view wx:if="{{activeTab !== 'questionnaire'}}" class="card-left">
          <view class="card-icon">{{item.icon}}</view>
        </view>

        <view wx:if="{{activeTab === 'questionnaire'}}" class="scale-card-main">
          <view class="scale-card-header">
            <view class="scale-card-info">
              <text class="card-title scale-title">{{item.title}}</text>
              <text class="card-time">{{item.createdAt}}</text>
              <text wx:if="{{item.summary}}" class="card-summary">{{item.summary}}</text>
            </view>
            <view class="scale-status-badge">{{item.status || '已保存'}}</view>
          </view>

          <view class="scale-card-footer">
            <text class="scale-view-result">查看分析结果 ></text>
          </view>
        </view>

        <view wx:else class="card-center">
          <text class="card-title">{{item.title}}</text>
          <text class="card-time">{{item.createdAt}}</text>
          <text wx:if="{{activeTab === 'tongue'}}" class="card-summary">{{item.summary || '暂无分析摘要'}}</text>
          <text wx:if="{{activeTab === 'tongue' && item.status}}" class="card-status">{{item.status}}</text>
          <view wx:if="{{activeTab === 'report'}}" class="card-meta-row">
            <text class="card-type">{{item.type}} · {{item.status}}</text>
            <text wx:if="{{item.fileCount > 0}}" class="card-file-count">{{item.fileCount}} 张图片</text>
          </view>
        </view>

        <view wx:if="{{activeTab !== 'questionnaire'}}" class="card-right">
          <text wx:if="{{activeTab === 'report' && item.uiState === 'deleting'}}" class="view-btn view-btn--danger">删除中</text>
          <text wx:else class="view-btn">查看</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
