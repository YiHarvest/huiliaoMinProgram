<view class="page">
  <view class="content">
    <view class="section-card">
      <view class="card-head">
        <view class="card-title-row">
          <text class="card-title">{{questionnaireName || '量表'}}</text>
        </view>
      </view>

      <view class="questionnaire-content">
        <view wx:if="{{loading}}" class="loading-section">
          <text class="loading-text">加载中...</text>
        </view>

        <view wx:elif="{{submitted && !isRefilling}}" class="success-section">
          <view class="success-badge">
            <text class="success-badge-icon">✓</text>
          </view>
          <text class="success-title">已保存</text>
          <text class="success-desc">当前量表已保存，如需修改可点击重新填写</text>
          <button class="refill-btn" bindtap="startRefillQuestionnaire">重新填写</button>
        </view>

        <view wx:elif="{{currentQuestion}}">
          <view class="progress-section">
            <view class="progress-info">
              <text class="total-count">第 {{currentQuestionIndex + 1}} / {{totalQuestions}} 题</text>
              <text class="answered-count">{{answeredCount}} / {{totalQuestions}} 已作答</text>
            </view>
            <view class="progress-bar">
              <view class="progress-fill" style="width: {{progressPercent}}%"></view>
            </view>
          </view>

          <view class="question-card">
            <view class="question-header">
              <text class="question-number">{{currentQuestionIndex + 1}}.</text>
              <text class="question-title">{{currentQuestion.title}}</text>
              <text wx:if="{{currentQuestion.isRequired}}" class="required-mark">*</text>
            </view>

            <radio-group
              wx:if="{{currentQuestion.options && currentQuestion.options.length > 0}}"
              bindchange="handleOptionChange"
              data-subject-id="{{currentQuestion.subjectId}}"
            >
              <view class="options-list">
                <label
                  wx:for="{{currentQuestion.options}}"
                  wx:for-item="option"
                  wx:key="value"
                  class="option-item {{answers[currentQuestion.subjectId] === option.value ? 'option-item--selected' : ''}}"
                >
                  <view class="option-indicator">
                    <radio
                      class="option-radio"
                      value="{{option.value}}"
                      checked="{{answers[currentQuestion.subjectId] === option.value}}"
                      color="#1890ff"
                    />
                  </view>
                  <text class="option-text">{{option.label}}</text>
                </label>
              </view>
            </radio-group>

            <view wx:else class="options-list">
              <view class="option-item text-input-wrapper">
                <view class="option-indicator">
                  <view class="text-input-placeholder"></view>
                </view>
                <textarea
                  class="text-input-inner"
                  placeholder="请输入您的答案"
                  placeholder-style="font-size:22rpx;color:#bbbbbb;"
                  value="{{answers[currentQuestion.subjectId]}}"
                  bindinput="handleTextInput"
                  data-subject-id="{{currentQuestion.subjectId}}"
                  auto-height
                />
              </view>
            </view>
          </view>

          <view class="bottom-actions">
            <button class="prev-btn" bindtap="goPrev" disabled="{{currentQuestionIndex === 0}}">上一题</button>

            <button
              wx:if="{{currentQuestionIndex < totalQuestions - 1}}"
              class="next-btn"
              bindtap="goNext"
            >
              下一题
            </button>

            <button wx:else class="save-btn" bindtap="submitQuestionnaire">保存</button>
          </view>
        </view>

        <view wx:else class="loading-section">
          <text class="loading-text">暂无题目</text>
        </view>
      </view>
    </view>
  </view>
</view>
