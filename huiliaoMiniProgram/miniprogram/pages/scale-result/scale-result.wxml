<view class="page">
  <view wx:if="{{loading}}" class="state state-loading">
    <view class="spinner"></view>
    <text class="state-text">正在加载...</text>
  </view>

  <view wx:elif="{{error}}" class="state state-error">
    <text class="state-title">加载失败</text>
    <text class="state-text">{{errorMsg}}</text>
    <button class="retry-btn" bindtap="loadData">重新加载</button>
  </view>

  <scroll-view wx:else class="content" scroll-y>
    <view class="ai-disclosure">
      <text class="ai-disclosure-label">AI生成</text>
      <text class="ai-disclosure-text">本页分析结果由人工智能生成，仅供参考，不能替代医生诊疗。</text>
    </view>

    <view class="hero-card">
      <text class="info-badge">量表分析结果</text>
      <text class="info-title">{{title || questionnaireName || '量表分析结果'}}</text>

      <view class="info-meta">
        <view class="meta-item" wx:if="{{doctorName}}">
          <text class="meta-label">医生</text>
          <text class="meta-value">{{doctorName}}</text>
        </view>
        <view class="meta-item" wx:if="{{completedAt}}">
          <text class="meta-label">填写时间</text>
          <text class="meta-value">{{completedAt}}</text>
        </view>
        <view class="meta-item" wx:if="{{updatedAt}}">
          <text class="meta-label">更新时间</text>
          <text class="meta-value">{{updatedAt}}</text>
        </view>
        <view class="meta-item">
          <text class="meta-label">状态</text>
          <text class="meta-value status-completed">已填写</text>
        </view>
      </view>
    </view>

    <view class="section-card analysis-card">
      <text class="section-card-title">结果分析</text>
      <view class="analysis-content">
        <block wx:if="{{analysisBlocks && analysisBlocks.length}}">
          <view
            wx:for="{{analysisBlocks}}"
            wx:key="index"
            class="analysis-block {{item.type === 'title' ? 'analysis-block--title' : 'analysis-block--paragraph'}}"
          >
            <text>{{item.text}}</text>
          </view>
        </block>
        <text wx:else class="analysis-text">{{analysisText || '量表已填写完成，医生可结合您的病情描述和量表结果进一步查看。'}}</text>
      </view>
    </view>

    <view class="section-card tip-card">
      <view class="tip-header">
        <view class="tip-icon">ℹ️</view>
        <text class="section-card-title">温馨提示</text>
      </view>
      <view class="tip-content">
        <text class="tip-text">以上内容仅供医生参考，不构成诊断依据。</text>
      </view>
    </view>
  </scroll-view>
</view>
