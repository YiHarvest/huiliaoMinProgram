<view class="page">
  <scroll-view class="page-scroll" scroll-y enable-flex="true">
    <view class="content">
      <view class="section-card">
        <view class="section-title-row">
          <text class="section-title">医生信息</text>
          <text class="section-badge section-badge-required">必填</text>
        </view>

        <picker
          class="doctor-picker"
          mode="selector"
          range="{{doctorPickerRange}}"
          value="{{doctorPickerIndex}}"
          bindchange="onDoctorPickerChange"
          disabled="{{!doctorOptions.length}}"
        >
          <view class="doctor-selector">
            <text class="doctor-value {{!selectedDoctor ? 'doctor-placeholder' : ''}}">{{selectedDoctorText || '请确认医生信息'}}</text>
            <text class="doctor-arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="section-card">
        <view class="report-head">
          <view class="report-title-wrap">
            <text class="card-title">上传报告图片</text>
            <text class="report-hint">支持 jpg、png、gif 等图片格式</text>
          </view>
          <text class="report-count">{{reportImages.length}}/{{maxReportImages}}</text>
        </view>

        <view class="report-grid">
          <view
            class="report-item"
            wx:for="{{reportImages}}"
            wx:key="url"
          >
            <image
              class="report-image"
              src="{{item.url}}"
              mode="aspectFill"
              bindtap="onPreviewReportImage"
              data-url="{{item.url}}"
            />
            <view class="report-remove" bindtap="onRemoveReportImage" data-index="{{index}}">×</view>
          </view>

          <view
            class="report-upload {{reportImages.length >= maxReportImages ? 'report-upload-disabled' : ''}}"
            wx:if="{{reportImages.length < maxReportImages}}"
            bindtap="onChooseReportImages"
          >
            <text class="upload-plus">+</text>
          </view>
        </view>
      </view>

      <view class="section-card">
        <view class="section-title-row">
          <text class="section-title">报告类型</text>
          <text class="section-badge section-badge-required">必填</text>
        </view>

        <view class="type-selector" bindtap="onChooseReportType">
          <view class="type-content {{!selectedReportType ? 'type-content-placeholder' : ''}}">
            <text>{{selectedReportType || '请选择报告类型'}}</text>
          </view>
          <text class="type-arrow">></text>
        </view>
      </view>

      <view class="section-card" wx:if="{{selectedReportType === '其他' || selectedReportType}}">
        <view class="section-title-row">
          <text class="section-title">报告备注</text>
          <view class="section-badge {{selectedReportType === '其他' ? 'section-badge-required' : 'section-badge-optional'}}">{{selectedReportType === '其他' ? '必填' : '选填'}}</view>
        </view>

        <textarea
          class="remark-input"
          placeholder="{{selectedReportType === '其他' ? '请填写具体的检查项目名称，如：精液检查、甲状腺功能等' : '可选填写，如：卵泡监测、月经第3天抽血等'}}"
          value="{{remark}}"
          bindinput="onRemarkInput"
          maxlength="100"
          auto-height
        />
      </view>

      <view class="submit-spacer"></view>
    </view>
  </scroll-view>

  <view class="submit-bar">
    <button class="submit-btn {{!canSubmit ? 'submit-btn-disabled' : ''}}" disabled="{{!canSubmit}}" bindtap="onSubmit">
      提交报告
    </button>
  </view>
</view>
