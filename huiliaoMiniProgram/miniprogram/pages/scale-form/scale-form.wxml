<view class="page">
  <scroll-view class="page-scroll" scroll-y enable-flex="true">
    <view class="content">
      <view class="section-card">
        <view class="card-head">
          <view class="card-title-row">
            <text class="card-title">医生信息</text>
            <text class="field-tag field-tag-required">必填</text>
          </view>
        </view>

        <picker
          class="doctor-picker"
          mode="selector"
          range="{{doctorPickerRange}}"
          value="{{doctorPickerIndex}}"
          bindchange="onDoctorPickerChange"
          disabled="{{!doctorOptions.length}}"
        >
          <view class="doctor-selector">
            <text class="doctor-value {{!selectedDoctor ? 'doctor-placeholder' : ''}}">{{selectedDoctorText || '请确认医生信息'}}</text>
            <text class="doctor-arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="section-card">
        <view class="star-title-row">
          <text class="star-mark">*</text>
          <text class="card-title">性别</text>
        </view>

        <view class="gender-row">
          <view
            class="gender-option {{selectedGender === item.value ? 'gender-option-active' : ''}}"
            wx:for="{{genderOptions}}"
            wx:key="value"
            data-value="{{item.value}}"
            bindtap="onSelectGender"
          >
            <view class="gender-radio {{selectedGender === item.value ? 'gender-radio-active' : ''}}">
              <view class="gender-radio-dot"></view>
            </view>
            <text class="gender-label">{{item.label}}</text>
          </view>
        </view>
      </view>

      <view class="section-card">
        <view class="card-head">
          <view class="card-title-row">
            <text class="card-title">疾病类型</text>
            <text class="field-tag field-tag-required">必填</text>
          </view>
        </view>

        <picker
          class="disease-picker"
          mode="selector"
          range="{{diseasePickerRange}}"
          value="{{diseasePickerIndex}}"
          bindchange="onDiseasePickerChange"
          disabled="{{!diseaseOptions.length}}"
        >
          <view class="selector-box">
            <view class="selector-main">
              <text class="selector-value {{!selectedDisease ? 'selector-placeholder' : ''}}">{{selectedDiseaseText || '请选择疾病类型'}}</text>
              <text wx:if="{{selectedDisease && selectedDisease.description}}" class="selector-desc">{{selectedDisease.description}}</text>
            </view>
            <text class="doctor-arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="section-card">
        <view class="card-head">
          <view class="card-title-row">
            <text class="card-title">本次就诊类型</text>
            <text class="field-tag field-tag-required">必填</text>
          </view>
        </view>

        <picker
          class="visit-type-picker"
          mode="selector"
          range="{{visitTypePickerRange}}"
          value="{{visitTypePickerIndex}}"
          bindchange="onVisitTypePickerChange"
          disabled="{{!visitTypeOptions.length}}"
        >
          <view class="selector-box">
            <view class="selector-main">
              <text class="selector-value">{{selectedVisitTypeText || '请选择就诊类型'}}</text>
              <text wx:if="{{selectedVisitType && selectedVisitType.description}}" class="selector-desc">{{selectedVisitType.description}}</text>
            </view>
            <text class="doctor-arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="scale-section">
        <text class="scale-section-title">量表</text>

        <view class="scale-hint" wx:if="{{!selectedDoctor}}">
          <text class="scale-hint-text">请先选择医生</text>
        </view>

        <view class="scale-hint" wx:elif="{{!isLoading && selectedDoctor && !diseaseOptions.length}}">
          <text class="scale-hint-text">当前医生暂无可用疾病类型</text>
        </view>

        <view class="scale-hint" wx:elif="{{!selectedDisease || !selectedVisitType}}">
          <text class="scale-hint-text">请先选择疾病类型和本次就诊类型</text>
        </view>

        <view class="scale-hint" wx:elif="{{isLoading && !visibleScales.length}}">
          <text class="scale-hint-text">正在加载量表...</text>
        </view>

        <view class="scale-hint" wx:elif="{{!visibleScales.length}}">
          <text class="scale-hint-text">当前条件下暂无可填写量表</text>
        </view>

        <view class="scale-list" wx:elif="{{visibleScales.length}}">
          <view class="scale-card" wx:for="{{visibleScales}}" wx:key="id">
            <view class="scale-card-main">
              <view class="scale-header">
                <text class="scale-name">{{item.questionnaireName}}</text>
              </view>
              <text class="scale-department">{{item.description || '无描述'}}</text>
            </view>
            <button
              class="scale-action"
              bindtap="onStartScale"
              data-template-id="{{item.templateId}}"
              data-questionnaire-id="{{item.questionnaireId}}"
              data-name="{{item.questionnaireName}}"
            >开始</button>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
